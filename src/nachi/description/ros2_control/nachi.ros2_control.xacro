<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:macro name="nachi_ros2_control" params="name use_fake_hardware:=true nachi_ip">

    <ros2_control name="${name}" type="system">
      <hardware>
        <!-- ros2_control simulation -->
        <xacro:if value="${use_fake_hardware}">
          <plugin>mock_components/GenericSystem</plugin>
          <param name="mock_sensor_commands">false</param>
          <param name="state_following_offset">0.0</param>
        </xacro:if>
        <!-- physical hardware or CFD simulation -->
        <xacro:unless value="${use_fake_hardware}">
          <plugin>nachi_mz04/RobotSystem</plugin>
          <param name="nachi_ip">${nachi_ip}</param>
        </xacro:unless>
      </hardware>



      <joint name="Joint_1">
        <command_interface name="position">
          <param name="min">-2.9671</param>
          <param name="max">2.9671</param>
        </command_interface>
        <!--command_interface name="velocity"/>
          <param name="min">-3.1416</param>
          <param name="max">3.1416</param-->
        <state_interface name="position">
          <param name="initial_value">0</param>
        </state_interface>
        <!--state_interface name="velocity"/-->
      </joint>
      <joint name="Joint_2">
        <command_interface name="position">
          <param name="min">0</param>
          <param name="max">4.1015</param>
        </command_interface>
        <!--command_interface name="velocity"/>
          <param name="min">-3.1416</param>
          <param name="max">3.1416</param-->        
        <state_interface name="position">
          <param name="initial_value">1.5708</param>
        </state_interface>
        <!--state_interface name="velocity"/-->
      </joint>
      <joint name="Joint_3">
        <command_interface name="position">
          <param name="min">-2.1817</param>
          <param name="max">4.8869</param>
        </command_interface>
        <!--command_interface name="velocity"/>
          <param name="min">-3.1416</param>
          <param name="max">3.1416</param-->            
        <state_interface name="position">
          <param name="initial_value">0</param>
        </state_interface>
        <!--state_interface name="velocity"/-->
      </joint>
      <joint name="Joint_4">
        <command_interface name="position">
          <param name="min">-3.3161</param>
          <param name="max">3.3161</param>        
        </command_interface>
        <!--command_interface name="velocity"/>
          <param name="min">-6.2832</param>
          <param name="max">6.2832</param-->    
        <state_interface name="position">
          <param name="initial_value">0.0</param>
        </state_interface>
        <!--state_interface name="velocity"/-->
      </joint>
      <joint name="Joint_5">
        <command_interface name="position">
          <param name="min">-2.0944</param>
          <param name="max">2.0944</param>        
        </command_interface>
        <!--command_interface name="velocity"/>
          <param name="min">-6.2832</param>
          <param name="max">6.2832</param-->    
        <state_interface name="position">
          <param name="initial_value">0.0</param>
        </state_interface>
        <!--state_interface name="velocity"/-->
      </joint>
      <joint name="Joint_6">
        <command_interface name="position">
          <param name="min">-6.2832</param>
          <param name="max">6.2832</param>  
        </command_interface>
        <!--command_interface name="velocity"/>
          <param name="min">-6.2832</param>
          <param name="max">6.2832</param-->    
        <state_interface name="position">
          <param name="initial_value">0.0</param>
        </state_interface>
        <!--state_interface name="velocity"/-->
      </joint>
      <joint name="Joint_finger1">
        <command_interface name="position">
          <param name="min">0.0</param>
          <param name="max">0.025</param>
        </command_interface>
        <state_interface name="position">
          <param name="initial_value">0.0</param>
        </state_interface>
      </joint>
            <joint name="Joint_finger2">
        <state_interface name="position">
          <param name="initial_value">0.0</param>
        </state_interface>
      </joint>

    </ros2_control>

  </xacro:macro>

</robot>
