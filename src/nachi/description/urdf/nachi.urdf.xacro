<?xml version="1.0"?>

<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="mz04">

  <xacro:arg name="use_fake_hardware" default="true"/>
  <xacro:property name="use_fake_hardware" value="$(arg use_fake_hardware)"/>
  <xacro:arg name="nachi_ip" default="127.0.0.1"/>
  <xacro:property name="nachi_ip" value="$(arg nachi_ip)"/>


  <!-- Import nachi macro (collision and visual)-->
  <xacro:include filename="$(find nachi_mz04)/urdf/nachi_macro.xacro" />
  <xacro:MZ04 />


  <!-- Import nachi ros2_control description -->
  <xacro:include filename="$(find nachi_mz04)/ros2_control/nachi.ros2_control.xacro" />
  <xacro:nachi_ros2_control 
    name="MZ04Hardware"
    use_fake_hardware="${use_fake_hardware}"
    nachi_ip="${nachi_ip}"/>




</robot>
